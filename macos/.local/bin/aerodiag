#!/usr/bin/env bash
#
# aerodiag - capture AeroSpace failure-state diagnostics.
#
# Run this the moment AeroSpace hotkeys stop responding, BEFORE restarting
# AeroSpace. Restarting destroys the evidence.
#
# Writes a timestamped report to ~/.local/state/aerodiag/ and echoes it.
#
# Investigation context, ruled-out causes and the hypotheses each section below
# is testing: ~/.dotfiles/docs/aerospace-hotkey-debug.md

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aerodiag"
mkdir -p "$STATE_DIR"
STAMP=$(date '+%Y%m%d-%H%M%S')
REPORT="$STATE_DIR/$STAMP.txt"

# Run a command with a wall-clock timeout. macOS has no timeout(1) by default.
# Prints the command output; returns 124 if it had to be killed.
run_timeout() {
  local secs=$1
  shift
  "$@" &
  local cmd_pid=$!
  (
    sleep "$secs"
    kill -9 "$cmd_pid" 2>/dev/null
  ) &
  local watch_pid=$!
  wait "$cmd_pid" 2>/dev/null
  local rc=$?
  kill "$watch_pid" 2>/dev/null
  wait "$watch_pid" 2>/dev/null
  [ "$rc" -ge 128 ] && return 124
  return "$rc"
}

section() { printf '\n=== %s ===\n' "$1"; }

collect() {
  printf 'aerodiag report\n'
  printf 'timestamp: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  printf 'uptime:   %s\n' "$(uptime)"

  # --- Hypothesis 1: macOS Secure Input blocks global hotkey interception ---
  section 'Secure Input'
  # The key is absent entirely while secure input is off, so sed emits a line
  # only for a session that actually holds it. Every holder is listed rather
  # than just the first: with several login sessions on this machine, reporting
  # one hides the others.
  local sipids
  sipids=$(ioreg -l -d 1 -k IOConsoleUsers 2>/dev/null \
    | sed -n 's/.*kCGSSessionSecureInputPID"=\([0-9]*\).*/\1/p' | grep -v '^0$' | sort -u)
  if [ -n "$sipids" ]; then
    printf 'STATUS: ON\n'
    local sipid
    while read -r sipid; do
      ps -p "$sipid" -o pid=,ppid=,comm= 2>/dev/null \
        || printf '%s (no longer exists -- stale hold)\n' "$sipid"
    done <<<"$sipids"
  else
    printf 'STATUS: OFF\n'
  fi

  # --- Hypothesis 2: AeroSpace server is dead, stalled, or disabled ---
  section 'AeroSpace process'
  pgrep -x AeroSpace >/dev/null && ps -p "$(pgrep -x AeroSpace | head -1)" -o pid=,etime=,%cpu=,%mem=,comm= \
    || printf 'AeroSpace NOT RUNNING\n'

  section 'AeroSpace server responsiveness (5s timeout)'
  local out
  # window-layout is the deciding evidence for the floating-window failure mode:
  # a floating window IS listed, it just sits outside the tiling tree. Without
  # this field the report looks identical to a healthy one. See the doc.
  out=$(run_timeout 5 aerospace list-windows --all \
    --format '%{window-id} | %{workspace} | %{window-layout} | %{app-name} | %{window-title}' 2>&1)
  if [ $? -eq 124 ]; then
    printf 'STALLED: list-windows did not return within 5s\n'
  else
    printf 'responsive\n%s\n' "$out"
  fi

  section 'AeroSpace version'
  run_timeout 5 aerospace --version 2>&1 || printf 'version query stalled\n'

  section 'AeroSpace window management enabled?'
  # `enable on --fail-if-noop` exits non-zero when management was ALREADY on.
  # So a non-zero exit is the healthy case, and a zero exit means we just
  # re-enabled it -- which both diagnoses and fixes an accidental disable.
  if run_timeout 5 aerospace enable on --fail-if-noop >/dev/null 2>&1; then
    printf 'WAS DISABLED -- aerodiag just re-enabled it. This was the cause.\n'
  else
    printf 'already enabled (normal)\n'
  fi

  # --- Hypothesis 3: another app grabbed the hotkeys / focus context ---
  section 'Frontmost app'
  local asn front
  asn=$(lsappinfo front 2>/dev/null)
  printf 'asn: %s\n' "${asn:-unknown}"
  front=$([ -n "$asn" ] && lsappinfo info -only name,bundleid,pid "$asn" 2>/dev/null)
  printf '%s\n' "$front"
  # A system authentication dialog owns the keyboard while it is up, so EVERY
  # global hotkey is dead for as long as it sits in front -- independently of
  # secure input, which may well read OFF. This is also the missing half of the
  # "restarting AeroSpace fixes it" puzzle: restarting means clicking elsewhere
  # first, and that dismisses or backgrounds the dialog. Check for the dialog
  # before believing AeroSpace is at fault at all.
  if printf '%s' "$front" | grep -Eq 'com\.apple\.(SecurityAgent|loginwindow|ScreenSaver)'; then
    printf '\nWARNING: a macOS system security dialog is frontmost.\n'
    printf 'It swallows all global hotkeys while displayed. Dismiss it and retest\n'
    printf 'BEFORE treating this as an AeroSpace fault.\n'
  fi

  section 'Keyboard input source'
  defaults read ~/Library/Preferences/com.apple.HIToolbox.plist AppleSelectedInputSources 2>/dev/null \
    || printf '(unreadable)\n'

  # --- Hypothesis 4: hotkeys died across a sleep/wake cycle ---
  section 'Recent sleep/wake (10s timeout)'
  out=$(run_timeout 10 pmset -g log 2>/dev/null)
  if [ $? -eq 124 ]; then
    printf '(pmset stalled)\n'
  else
    # Match pmset's event lines only (domain column right after the timezone
    # offset), not the far noisier assertion lines.
    printf '%s\n' "$out" \
      | grep -E '\+[0-9]{4} +(Sleep|Wake|DarkWake) ' \
      | grep -v 'Wake Requests' \
      | tail -8
  fi

  section 'Apps that commonly hold Secure Input'
  ps -Ao pid=,comm= | grep -Ei 'keepass|1password|bitwarden|secretive|screen ?sharing|Terminal|ssh-agent' \
    | grep -v grep || printf '(none matched)\n'
}

collect 2>&1 | tee "$REPORT"

printf '\nsaved: %s\n' "$REPORT"

# Echo this script's own leading comment block rather than a second copy of the
# same text, so the reminder can never drift out of sync with the header.
section 'What to do next'
awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
cat <<EOF

Hand this report to Claude Code from ~/.dotfiles -- it picks up the
investigation context automatically:

  cd ~/.dotfiles && claude
  > aerospace window management issue shows again, here is the aerodiag report: <paste $REPORT>
EOF
