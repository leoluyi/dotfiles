# vim: ft=sh:
# shellcheck shell=bash
# aichat shell integration (https://github.com/sigoden/aichat)

command -v aichat >/dev/null || return 0

# aichat derives each client's key from <CLIENT>_API_KEY, so the `claude` client
# reads CLAUDE_API_KEY and never sees ANTHROPIC_API_KEY. Mirror the value here.
# This file is sourced from ~/.config/bash/* before ~/.bash_profile loads
# ~/.secrets/*, so pull the secret in directly when it is not set yet.
if [ -z "$ANTHROPIC_API_KEY" ] && [ -r "$HOME/.secrets/ANTHROPIC_API_KEY" ]; then
  . "$HOME/.secrets/ANTHROPIC_API_KEY"
fi
if [ -n "$ANTHROPIC_API_KEY" ]; then
  export CLAUDE_API_KEY="${CLAUDE_API_KEY:-$ANTHROPIC_API_KEY}"
fi

# Usage: ?? <question>
# Usage: <cmd> | ??
alias ??='aichat'
