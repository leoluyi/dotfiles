#!/usr/bin/env bash
#
# aerospace-drift-log - sample tiling-app windows and record floating drift.
#
# Answers one question the after-the-fact aerodiag report cannot: when a
# terminal window ends up `floating`, was it born that way (on-window-detected
# callback lost the race) or did it start tiled and change later (something is
# resetting it post-detection)? Those two answers need different fixes.
#
# Runs from launchd every 60s. Writes only on state CHANGE, so a quiet log
# means nothing drifted -- see docs/aerospace-hotkey-debug.md.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aerospace-drift"
SEEN="$STATE_DIR/seen.tsv"
LOG="$STATE_DIR/drift.log"
AX_DIR="$STATE_DIR/ax"
mkdir -p "$STATE_DIR" "$AX_DIR"
touch "$SEEN"

# Apps the config puts under tiling. A floating window here is the anomaly;
# for every other app floating is the configured default and not interesting.
TILING_APPS='com.mitchellh.ghostty|org.alacritty|com.github.wez.wezterm'

NOW=$(date +%s)
STAMP=$(date '+%Y-%m-%d %H:%M:%S')

note() { printf '%s\t%s\n' "$STAMP" "$1" >>"$LOG"; }

# Snapshot what AeroSpace itself sees for a window at the moment it leaves the
# tiling tree. `window-layout` only reports that the parent container is now
# `floating`; it never says why. The AX dump does: compare AXSubrole,
# AXFullScreen, AXMinimized and any `Aero.AxFailed` markers against a healthy
# window to test whether AeroSpace re-classified it as untileable -- the leading
# hypothesis, since a busy app makes AX queries fail app-wide and every window
# of that app drifts at once.
#
# Only the transition INTO floating is captured. Recoveries add no information
# and the dumps are tens of KB each.
capture_ax() {
  local wid=$1 app=$2 fs=$3 prev_fs=$4
  local file="$AX_DIR/$(date '+%Y%m%d-%H%M%S')-$wid.txt"
  {
    printf 'captured:   %s\nwindow-id:  %s\napp:        %s\nfullscreen: %s (previous sample: %s)\nloadavg:    %s\n' \
      "$STAMP" "$wid" "$app" "$fs" "$prev_fs" "$(sysctl -n vm.loadavg 2>/dev/null)"
    printf '\n=== CPU of the processes involved ===\n'
    ps -Ao pid=,%cpu=,%mem=,comm= | grep -Ei 'AeroSpace|ghostty' | grep -v grep
    printf '\n=== aerospace debug-windows --window-id %s ===\n' "$wid"
    aerospace debug-windows --window-id "$wid" 2>&1
  } >"$file"
}

if ! pgrep -x AeroSpace >/dev/null 2>&1; then
  # Recorded so a gap in the log is never mistaken for "nothing drifted".
  note $'AEROSPACE_DOWN\t-\t-'
  exit 0
fi

# Built with an explicit tab variable: AeroSpace takes the separator literally
# and does not expand a backslash-t escape.
tab=$'\t'
# `window-is-fullscreen` is orthogonal to `window-layout`: a fullscreen window
# still reports its parent layout (`h_accordion`, ...), never `floating`, so
# fullscreen alone cannot produce a drift record. It is sampled anyway because
# AeroSpace clears the flag silently on a new window, a workspace switch or an
# unhide -- without it in the log there is no way to tell afterwards whether a
# window had just been dropped out of fullscreen when it drifted.
#
# app-name is kept last: it is the only free-text field.
windows=$(aerospace list-windows --all \
  --format "%{window-id}${tab}%{app-bundle-id}${tab}%{window-layout}${tab}%{window-is-fullscreen}${tab}%{app-name}" 2>/dev/null)
if [ -z "$windows" ]; then
  note $'QUERY_FAILED\t-\t-'
  exit 0
fi

# Carry forward only the windows still alive, so the state file cannot grow
# without bound and a recycled window-id starts clean.
next_seen=""

while IFS=$'\t' read -r wid bundle layout fs app; do
  [ -n "$wid" ] || continue
  printf '%s' "$bundle" | grep -Eq "^($TILING_APPS)$" || continue

  # An app hidden with cmd-H reports macos_native_window_of_hidden_app, which
  # masks the real layout. That is a missing observation, not a state -- keep
  # the previous record untouched rather than recording a false transition.
  case "$layout" in
    floating) state=floating ;;
    macos_native_window_of_hidden_app) state=unobservable ;;
    *) state=tiled ;;
  esac

  prev=$(awk -F'\t' -v w="$wid" '$1 == w { print; exit }' "$SEEN")

  if [ -z "$prev" ]; then
    if [ "$state" = unobservable ]; then
      continue  # nothing learned yet; record on a later sample
    fi
    next_seen+="$wid"$'\t'"$NOW"$'\t'"$state"$'\t'"$state"$'\t'"$fs"$'\n'
    if [ "$state" = floating ]; then
      note "BORN_FLOATING"$'\t'"$wid"$'\t'"$app (fullscreen=$fs)"
      capture_ax "$wid" "$app" "$fs" "-"
    fi
    continue
  fi

  first_seen=$(printf '%s' "$prev" | cut -f2)
  first_state=$(printf '%s' "$prev" | cut -f3)
  last_state=$(printf '%s' "$prev" | cut -f4)
  # Absent in records written before the fullscreen column existed.
  last_fs=$(printf '%s' "$prev" | cut -f5)
  [ -n "$last_fs" ] || last_fs=unknown

  # The layout is masked while the app is hidden but the fullscreen flag is
  # still readable, so keep tracking it rather than freezing the whole record.
  if [ "$state" = unobservable ]; then
    next_seen+="$wid"$'\t'"$first_seen"$'\t'"$first_state"$'\t'"$last_state"$'\t'"$fs"$'\n'
    continue
  fi

  if [ "$state" != "$last_state" ]; then
    age=$((NOW - first_seen))
    if [ "$state" = floating ]; then
      note "DRIFTED_TO_FLOATING"$'\t'"$wid"$'\t'"$app (age ${age}s, first seen as $first_state, fullscreen=$fs, previous sample=$last_fs)"
      capture_ax "$wid" "$app" "$fs" "$last_fs"
    else
      note "RECOVERED_TO_TILED"$'\t'"$wid"$'\t'"$app (age ${age}s, fullscreen=$fs)"
    fi
  fi

  next_seen+="$wid"$'\t'"$first_seen"$'\t'"$first_state"$'\t'"$state"$'\t'"$fs"$'\n'
done <<<"$windows"

printf '%s' "$next_seen" >"$SEEN"
