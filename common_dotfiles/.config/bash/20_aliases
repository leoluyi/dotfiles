# Enable aliases to be sudo'ed.
alias sudo='sudo '

# Enable aliases for watch.
alias watch='watch -n1 '

# ls / eza
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -la --git --group-directories-first --time-style=long-iso --icons=auto'
  alias la='eza -a --git --group-directories-first --icons=auto'
  alias l='eza -F=auto --icons=auto'
  alias lrt='eza -l --sort=modified --time-style=long-iso --icons=auto'
  alias lx='eza -l --sort=extension --icons=auto'
  alias lt='eza --tree --level=2 --icons=auto'
else
  alias ll='ls -lvhaF --time-style="+%Y-%m-%d %H:%M"'
  alias la='ls -A'
  alias l='ls -CF'
  alias lrt='ls -hlrt --time-style=long-iso'
fi

# Always enable colored `grep` output.
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='grep -F --color=auto'
alias egrep='grep -E --color=auto'

# less 選項統一由 10_env 的 $LESS 提供，確保非互動情境（$PAGER）行為一致。

# Neovim.
if command -v nvim >/dev/null; then
  alias ovim="command vim"
  alias vi="nvim"
  alias vim="nvim"
  alias view="nvim -R"
  alias vimdiff="nvim -d"
fi

# Print each PATH entry on a separate line.
alias path='echo -e ${PATH//:/\\n}'

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# IP addresses.
alias myip='dig +short myip.opendns.com @resolver1.opendns.com'
#alias localip="ipconfig getifaddr en0"
alias myips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Fancy commands output.
alias du='du -k'
alias df='df -kT'
command -v free >/dev/null && alias free='free -h'

# Find the largest top 10 files and directories.
alias ducks='du -cksh -- * .[^.]* | sort -rh | head'

# temp folder.
alias cdtemp='cd $(mktemp -d)'

# Toggle shell history.
alias history-off='set +o history'
alias history-on='set -o history'
# Clear last hour history.
alias history-clearlast20="[ -f $HISTFILE ] && HISTTIMEFORMAT='%s ' history | awk -v d1=\"\$(date --date='-20 min' '+%s')\" '(\$2 > d1 ) { print \$2 }' | xargs -I {} sed -i '/^.*:{}:/{N;d;}' $HISTFILE && history -c && history -r"
alias history-clear='[ -f "$HISTFILE" ] && cat /dev/null > "$HISTFILE" && history -c'

# Claude Code.
# -u ANTHROPIC_API_KEY: force subscription auth, never API-key billing
# even if something else in the environment exports the key.
if command -v claude >/dev/null; then
  alias c='env -u ANTHROPIC_API_KEY claude'
  alias ch='env -u ANTHROPIC_API_KEY claude --chrome'
  alias cs='env -u ANTHROPIC_API_KEY claude --dangerously-skip-permissions'
fi

# Codex CLI.
# -u OPENAI_API_KEY: force ChatGPT subscription auth, never API-key billing
# even if something else in the environment exports the key.
if command -v codex >/dev/null; then
  codex_ensure_local_profile() {
    local codex_home="${CODEX_HOME:-$HOME/.codex}"
    local profile_path="$codex_home/local.config.toml"

    if [ -f "$profile_path" ]; then
      return 0
    fi

    if [ -L "$profile_path" ] || [ -e "$profile_path" ]; then
      printf 'Codex local profile is not a regular file: %s\n' "$profile_path" >&2
      return 1
    fi

    mkdir -p "$codex_home" || return 1
    if ! (umask 077; set -C; : > "$profile_path") 2>/dev/null; then
      if [ ! -f "$profile_path" ]; then
        printf 'could not create Codex local profile: %s\n' "$profile_path" >&2
        return 1
      fi
    fi
  }

  codex_local_profile() {
    codex_ensure_local_profile || return 1
    env -u OPENAI_API_KEY codex --profile local --approve-for-me "$@"
  }

  alias cx='codex_local_profile'
  alias cx-yolo='cx --dangerously-bypass-approvals-and-sandbox'
  alias cx-search='cx --search'
  alias cx-exec='cx exec'
  alias cx-resume='cx resume --last'
  alias codex-reset-checker='npx -y @willh/codex-reset-checker'

  # Create and enter an isolated worktree for the dotfiles repository.
  cx-worktree() {
    local repo_root="$HOME/.dotfiles"
    local name="${1:-}"
    local worktree_path
    local random_id

    if [ "$#" -gt 1 ]; then
      printf 'usage: cx-worktree [name]\n' >&2
      return 2
    fi

    if [ ! -e "$repo_root/.git" ]; then
      printf 'dotfiles repository not found: %s\n' "$repo_root" >&2
      return 1
    fi

    if [ -z "$name" ]; then
      if command -v uuidgen >/dev/null 2>&1; then
        random_id="$(uuidgen | tr -d '-' | cut -c1-8)"
      elif command -v openssl >/dev/null 2>&1; then
        random_id="$(openssl rand -hex 4)"
      else
        random_id="$(date +%s)"
      fi
      name="cx-$random_id"
    fi

    if ! git -C "$repo_root" check-ref-format --branch "$name" >/dev/null 2>&1; then
      printf 'invalid branch name: %s\n' "$name" >&2
      return 2
    fi

    worktree_path="$repo_root/.worktrees/$name"
    if [ -e "$worktree_path" ]; then
      printf 'worktree path already exists: %s\n' "$worktree_path" >&2
      return 1
    fi

    mkdir -p "$(dirname "$worktree_path")" || return 1
    git -C "$repo_root" worktree add -b "$name" "$worktree_path" HEAD || return
    cd "$worktree_path" || return
    printf 'entered worktree: %s\n' "$worktree_path"
    codex_local_profile
  }
fi

# Worktrunk.
if command -v wt >/dev/null; then
  cx-wt() {
    local name="${1:-}"
    local adjectives=(
      amber bold brave bright calm clear clever crisp eager gentle grand
      happy keen kind lively lucid mellow nimble noble quiet rapid ready
      silver steady swift vivid warm wild wise
    )
    local nouns=(
      acorn badger beacon birch cedar comet coral cypress ember falcon
      fern fox grove harbor hawk heron island juniper lantern lark maple
      meadow moon oak ocean otter panda pebble pine raven reef ridge river
      robin shore sparrow star stone summit tiger valley whale willow wren
    )
    local attempt

    if [ "$#" -gt 1 ]; then
      printf 'usage: cx-wt [name]\n' >&2
      return 2
    fi

    if [ -z "$name" ]; then
      for ((attempt = 0; attempt < 20; attempt++)); do
        name="worktree-${adjectives[$((RANDOM % ${#adjectives[@]}))]}-${nouns[$((RANDOM % ${#nouns[@]}))]}"
        if ! git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
          break
        fi
      done

      if [ "$attempt" -eq 20 ]; then
        printf 'could not generate an unused worktree name\n' >&2
        return 1
      fi
    fi

    wt --config "$HOME/.dotfiles/common_dotfiles/.config/worktrunk/config.toml" \
      switch --create --base=@ --cd \
      --execute 'env -u OPENAI_API_KEY codex --profile local --approve-for-me' "$name"
  }
fi

# Antigravity CLI (agy).
if command -v agy >/dev/null; then
  alias agy-yolo='agy --dangerously-skip-permissions'
fi
